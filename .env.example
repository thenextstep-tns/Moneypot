# Copy to .env.local and fill in. Leave empty to run in local demo mode (localStorage).
VITE_FB_API_KEY=
VITE_FB_AUTH_DOMAIN=
VITE_FB_PROJECT_ID=
VITE_FB_APP_ID=
# Discord login
VITE_DISCORD_CLIENT_ID=
# URL of the deployed `discordAuth` Cloud Function, e.g. https://discordauth-xxxx-ew.a.run.app
VITE_DISCORD_FN_URL=
