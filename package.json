{
  "name": "pots-budget",
  "private": true,
  "version": "0.9.7",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm test && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node scripts/sync-domain.mjs --check && tsx --test tests/domain.test.ts",
    "sync:domain": "node scripts/sync-domain.mjs",
    "test:rules": "npx --yes firebase-tools@13 emulators:exec --only firestore --project demo-moneypot \"tsx --test tests/rules.test.ts tests/sharing-e2e.test.ts\""
  },
  "dependencies": {
    "firebase": "^10.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.4",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "tsx": "^4.19.2",
    "typescript": "^5.5.0",
    "vite": "^5.3.0"
  }
}
