rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    function isSignedIn() { return request.auth != null; }
    function isOwner(uid) { return isSignedIn() && request.auth.uid == uid; }

    // users/{uid} holds settings; everything else lives in its subcollections
    match /users/{uid} {
      allow read, write: if isOwner(uid);

      // accounts | categories | plans | stashes | payments | transfers | invites | templates
      match /{coll}/{id} {
        allow read, delete: if isOwner(uid) || (
          isSignedIn() && coll in ['categories', 'stashes', 'payments', 'transfers', 'invites']
        );
        allow create, update: if isSignedIn()
          && coll in ['accounts', 'categories', 'plans', 'stashes', 'payments', 'transfers', 'invites', 'templates']
          && (
            isOwner(uid)
            || coll in ['categories', 'stashes', 'payments', 'transfers', 'invites']
          );
      }
    }

    // Shared collaboration collections for invites, shared stashes, shared payments, and shared transfers
    match /invites/{id} {
      allow read, write: if isSignedIn();
    }
    match /shared_stashes/{id} {
      allow read, write: if isSignedIn();
    }
    match /shared_payments/{id} {
      allow read, write: if isSignedIn();
    }
    match /shared_transfers/{id} {
      allow read, write: if isSignedIn();
    }

    // collectionGroup queries (invites lookup and owner docs)
    match /{path=**}/invites/{id} {
      allow read, write: if isSignedIn();
    }
    match /{path=**}/{coll}/{id} {
      allow read: if isSignedIn() && resource.data.ownerId == request.auth.uid;
    }
  }
}
